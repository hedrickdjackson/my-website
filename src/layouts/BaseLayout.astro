---
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Jackson Hedrick",
	description = "Personal website and resume.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,500;8..60,600&family=Source+Sans+3:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<div class="page">
			<SiteHeader />
			<main>
				<slot />
			</main>
			<footer class="footer">
				<p>© 2026 Jackson Hedrick</p>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg: #f3f5f7;
		--ink: #1a1f26;
		--muted: #5b6570;
		--line: #d5dae0;
		--accent: #1d4ed8;
		--font-display: "Source Serif 4", Georgia, serif;
		--font-body: "Source Sans 3", system-ui, sans-serif;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		min-height: 100vh;
		color: var(--ink);
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.6;
		background: var(--bg);
	}

	.page {
		width: min(40rem, calc(100% - 2rem));
		margin: 0 auto;
		padding: 3rem 0 4rem;
	}

	a {
		color: var(--accent);
	}

	h1,
	h2 {
		font-family: var(--font-display);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.page-title {
		margin: 0 0 1rem;
		font-size: 1.5rem;
	}

	.prose {
		margin: 0;
		color: var(--muted);
		max-width: 34rem;
	}

	.list {
		margin: 0;
		padding-left: 1.15rem;
		color: var(--muted);
	}

	.list li + li {
		margin-top: 0.35rem;
	}

	.entry + .entry {
		margin-top: 1.25rem;
	}

	.entry-top {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		align-items: baseline;
		margin-bottom: 0.25rem;
	}

	.entry p {
		margin: 0;
		color: var(--muted);
	}

	.meta {
		color: var(--muted);
		font-size: 0.95rem;
		white-space: nowrap;
	}

	.note {
		margin-top: 1rem;
		color: var(--muted);
		font-style: italic;
	}

	.footer {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.9rem;
	}

	.footer p {
		margin: 0;
	}
</style>
