---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Jackson Hedrick">
	<section id="about" data-panel role="tabpanel" aria-labelledby="tab-about">
		<h1 class="page-title">About</h1>
		<p class="prose">
			I am currently a student at Bellevue College, and I’m applying to the
			University of Washington to pursue B.S. degrees in Earth and Space
			Sciences: Geology and Electrical and Computer Engineering.
		</p>

		<h2 class="subhead">Interests</h2>
		<ul class="list">
			<li>Geology</li>
			<li>Paleontology</li>
			<li>Electrical Engineering</li>
			<li>Gaming</li>
		</ul>
	</section>

	<section
		id="experience"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-experience"
		hidden
	>
		<h1 class="page-title">Experience</h1>
		<p class="prose">TBD</p>
	</section>

	<section
		id="education"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-education"
		hidden
	>
		<h1 class="page-title">Education</h1>

		<div class="entry">
			<div class="entry-top">
				<strong>University of Washington</strong>
				<span class="meta">TBD</span>
			</div>
			<p>B.S. Earth and Space Sciences: Geology</p>
			<p>B.S. Electrical and Computer Engineering</p>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Bellevue College</strong>
				<span class="meta">2025 – 2026</span>
			</div>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Montana State University</strong>
				<span class="meta">2024 – 2025</span>
			</div>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Bellevue High School</strong>
				<span class="meta">Graduate (2026)</span>
			</div>
		</div>
	</section>

	<section
		id="projects"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-projects"
		hidden
	>
		<h1 class="page-title">Projects</h1>

		<div class="entry">
			<div class="entry-top">
				<strong>Personal website</strong>
				<span class="meta">2026</span>
			</div>
			<p>
				<a href="https://github.com/hedrickdjackson/my-website">
					github.com/hedrickdjackson/my-website
				</a>
			</p>
		</div>
	</section>

	<section
		id="contact"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-contact"
		hidden
	>
		<h1 class="page-title">Contact</h1>
		<ul class="list">
			<li>
				Email:{" "}
				<a href="mailto:example@gmail.com">example@gmail.com</a>
			</li>
			<li>
				Phone Number:{" "}
				<a href="tel:+19999999999">(999) 999-999</a>
			</li>
		</ul>
	</section>
</BaseLayout>

<style>
	.subhead {
		margin: 1.75rem 0 0.75rem;
		font-size: 1.1rem;
	}
</style>
