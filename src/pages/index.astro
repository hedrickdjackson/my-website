---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Jackson Hedrick">
	<section id="about" data-panel role="tabpanel" aria-labelledby="tab-about">
		<h1 class="page-title">About</h1>
		<p class="prose">
			I am currently a student at Bellevue College, and I’m applying to the
			University of Washington to pursue B.S. degrees in Earth and Space
			Sciences: Geology and Electrical and Computer Engineering.
		</p>
		<p class="prose" style="margin-top: 1rem">
			Outside of school, I enjoy working on computers, playing games, visiting
			museums, and, whenever possible, looking for fossils.
		</p>

		<h2 class="subhead">Interests</h2>
		<ul class="list">
			<li>
				Geology &amp; Paleontology
				<ul class="list">
					<li>
						Hunting and studying fossils, especially dinosaur fossils.
					</li>
				</ul>
			</li>
			<li>
				Electrical Engineering
				<ul class="list">
					<li>
						Math and physics and applying it to real world engineering.
					</li>
				</ul>
			</li>
			<li>
				Gaming
				<ul class="list">
					<li>
						Playing a variety of PC games online with friends.
					</li>
				</ul>
			</li>
		</ul>
	</section>

	<section
		id="experience"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-experience"
		hidden
	>
		<h1 class="page-title">Experience</h1>

		<div class="entry">
			<div class="entry-top">
				<strong>Intern · NextStep</strong>
				<span class="meta">Sep 1, 2026 – Present</span>
			</div>
		</div>
	</section>

	<section
		id="education"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-education"
		hidden
	>
		<h1 class="page-title">Education</h1>

		<div class="entry">
			<div class="entry-top">
				<strong>University of Washington</strong>
				<span class="meta">TBD</span>
			</div>
			<p>B.S. Earth and Space Sciences: Geology</p>
			<p>B.S. Electrical and Computer Engineering</p>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Bellevue College</strong>
				<span class="meta">2025 – 2026</span>
			</div>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Montana State University</strong>
				<span class="meta">2024 – 2025</span>
			</div>
		</div>

		<div class="entry">
			<div class="entry-top">
				<strong>Bellevue High School</strong>
				<span class="meta">Graduate (2025-2026)</span>
			</div>
		</div>
	</section>

	<section
		id="projects"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-projects"
		hidden
	>
		<h1 class="page-title">Projects</h1>

		<div class="entry">
			<div class="entry-top">
				<strong>
					<a class="project-link" href="https://github.com/hedrickdjackson/my-website">
						Personal website
						<span class="ext" aria-hidden="true">↗</span>
					</a>
				</strong>
				<span class="meta">2026</span>
			</div>
		</div>
	</section>

	<section
		id="contact"
		data-panel
		role="tabpanel"
		aria-labelledby="tab-contact"
		hidden
	>
		<h1 class="page-title">Contact</h1>
		<ul class="list">
			<li>
				Email:{" "}
				<a class="js-email" href="#">Enable JavaScript to view</a>
			</li>
			<li>
				Phone Number:{" "}
				<a class="js-phone" href="#">Enable JavaScript to view</a>
			</li>
		</ul>
	</section>
</BaseLayout>

<script>
	function decode(value: string) {
		return atob(value);
	}

	const email = decode("amFja3NvbmRoZWRyaWNrQGdtYWlsLmNvbQ==");
	const phoneDigits = decode("NDA2NTk5NTQwMg==");
	const phoneDisplay = `(${phoneDigits.slice(0, 3)}) ${phoneDigits.slice(3, 6)}-${phoneDigits.slice(6)}`;

	document.querySelectorAll<HTMLAnchorElement>(".js-email").forEach((link) => {
		link.textContent = email;
		link.href = `mailto:${email}`;
	});

	document.querySelectorAll<HTMLAnchorElement>(".js-phone").forEach((link) => {
		link.textContent = phoneDisplay;
		link.href = `tel:+1${phoneDigits}`;
	});
</script>

<style>
	.subhead {
		margin: 1.75rem 0 0.75rem;
		font-size: 1.1rem;
	}

	.list .list {
		margin-top: 0.35rem;
		margin-bottom: 0.15rem;
	}

	.project-link {
		color: var(--ink);
		text-decoration: none;
	}

	.project-link:hover {
		color: var(--accent);
	}

	.ext {
		margin-left: 0.2rem;
		font-size: 0.85em;
		font-weight: 500;
	}
</style>
